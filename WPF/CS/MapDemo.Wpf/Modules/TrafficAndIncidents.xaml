<local:MapDemoModule
    x:Class="MapDemo.TrafficAndIncidents"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
    xmlns:dxmt="http://schemas.devexpress.com/winfx/2008/xaml/map/themekeys"
    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:local="clr-namespace:MapDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="557"
    d:DesignWidth="2643">
    <local:MapDemoModule.Resources>
        <local:DemoValuesProvider x:Key="DemoValuesProvider" />
        <local:EnumDescriptionConverter x:Key="enumDescriptionConverter" />
    </local:MapDemoModule.Resources>
    <DockPanel>
        <ScrollViewer
            DockPanel.Dock="Right"
            dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            Name="PART_Options"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MinWidth="210"
                MaxWidth="210"
                Margin="12,0,12,12">
                <GroupBox Margin="0,5,0,0" Header="Travel Mode">
                    <dxe:ListBoxEdit
                        Background="{x:Null}"
                        ItemsSource="{dxe:EnumItemsSource EnumType=dxm:AzureTravelMode}"
                        Name="travelModeRadioGroup"
                        SelectedIndex="2"
                        SelectedIndexChanged="RoutePropertyChanged"
                        ShowBorder="False">
                        <dxe:ListBoxEdit.StyleSettings>
                            <dxe:RadioListBoxEditStyleSettings />
                        </dxe:ListBoxEdit.StyleSettings>
                        <dxe:ListBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Converter={StaticResource enumDescriptionConverter}}" />
                            </DataTemplate>
                        </dxe:ListBoxEdit.ItemTemplate>
                    </dxe:ListBoxEdit>
                </GroupBox>
                <GroupBox Margin="0,5,0,0" Header="Avoid Types">
                    <dxe:ComboBoxEdit
                        ItemsSource="{Binding AzureRouteAvoidTypes, Source={StaticResource DemoValuesProvider}}"
                        Name="avoidTypesComboBox"
                        IsTextEditable="False"
                        NullText="None"
                        EditValueChanged="RoutePropertyChanged">
                        <dxe:ComboBoxEdit.StyleSettings>
                            <dxe:CheckedComboBoxStyleSettings/>
                        </dxe:ComboBoxEdit.StyleSettings>
                        <dxe:ComboBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Converter={StaticResource enumDescriptionConverter}}" />
                            </DataTemplate>
                        </dxe:ComboBoxEdit.ItemTemplate>
                    </dxe:ComboBoxEdit>
                </GroupBox>
                <GroupBox Margin="0,5,0,0" Header="Section Types">
                    <dxe:ComboBoxEdit
                        ItemsSource="{Binding AzureRouteSectionTypes, Source={StaticResource DemoValuesProvider}}"
                        Name="sectionTypesComboBox"
                        IsTextEditable="False"
                        NullText="None"
                        EditValueChanged="RoutePropertyChanged">
                        <dxe:ComboBoxEdit.StyleSettings>
                            <dxe:CheckedComboBoxStyleSettings/>
                        </dxe:ComboBoxEdit.StyleSettings>
                        <dxe:ComboBoxEdit.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Converter={StaticResource enumDescriptionConverter}}" />
                            </DataTemplate>
                        </dxe:ComboBoxEdit.ItemTemplate>
                    </dxe:ComboBoxEdit>
                </GroupBox>
                <GroupBox Margin="0,5,0,0" Header="Max Alternatives">
                    <dxe:SpinEdit
                        Name="maxAlternativesSpinEdit"
                        EditValue="0"
                        Increment="1"
                        MinValue="0"
                        MaxValue="5"
                        IsFloatValue="False"
                        EditValueChanged="RoutePropertyChanged" />
                </GroupBox>
                <dxe:CheckEdit Name="optimizeWaypointsCheckBox" Content="Compute Best Order" EditValueChanged="RoutePropertyChanged" />
            </StackPanel>
        </ScrollViewer>
        <Grid>
            <dxm:MapControl
                x:Name="mapControl"
                CenterPoint="{Binding MapCenterPoint, Mode=TwoWay}"
                FlowDirection="LeftToRight"
                IsManipulationEnabled="True"
                MinZoomLevel="5"
                ShowSearchPanel="True"
                ZoomLevel="11">
                <dxm:MapControl.ZoomTrackbarOptions>
                    <dxm:ZoomTrackbarOptions Visible="False" />
                </dxm:MapControl.ZoomTrackbarOptions>
                <dxm:MapControl.ScrollButtonsOptions>
                    <dxm:ScrollButtonsOptions Visible="False" />
                </dxm:MapControl.ScrollButtonsOptions>
                <dxm:MapControl.ScalePanelOptions>
                    <dxm:ScalePanelOptions Visible="False" />
                </dxm:MapControl.ScalePanelOptions>
                <dxm:MapControl.CoordinatesPanelOptions>
                    <dxm:CoordinatesPanelOptions Visible="False" />
                </dxm:MapControl.CoordinatesPanelOptions>
                <dxm:ImageLayer>
                    <dxm:AzureMapDataProvider
                        AzureKey="{Binding DevExpressAzureKey, Source={StaticResource DemoValuesProvider}}"
                        Tileset="BaseRoad" />
                </dxm:ImageLayer>
                <dxm:InformationLayer
                    x:Name="geocodeInformationLayer"
                    EnableHighlighting="False"
                    EnableSelection="False">
                    <dxm:AzureGeocodeDataProvider
                        AzureKey="{Binding DevExpressAzureKey, Source={StaticResource DemoValuesProvider}}"
                        LayerItemsGenerating="GeoCodeAndSearchLayerItemsGenerating"
                        MaxVisibleResultCount="1"
                        ProcessMouseEvents="True" />
                </dxm:InformationLayer>
                <dxm:InformationLayer
                    x:Name="routeInformationLayer"
                    EnableHighlighting="False"
                    EnableSelection="False"
                    Error="RouteLayerError">
                    <dxm:AzureRouteDataProvider
                        x:Name="routeProvider"
                        AzureKey="{Binding DevExpressAzureKey, Source={StaticResource DemoValuesProvider}}"
                        GenerateLayerItems="True"
                        LayerItemsGenerating="RouteItemsGenerating"
                        RouteStroke="#FF1E8CD2">
                        <dxm:AzureRouteDataProvider.RouteStrokeStyle>
                            <dxm:StrokeStyle
                                DashCap="Round"
                                EndLineCap="Round"
                                StartLineCap="Round"
                                Thickness="4" />
                        </dxm:AzureRouteDataProvider.RouteStrokeStyle>
                    </dxm:AzureRouteDataProvider>
                </dxm:InformationLayer>
                <dxm:VectorLayer EnableHighlighting="False" EnableSelection="False">
                    <dxm:ListSourceDataAdapter DataSource="{Binding Items}" />
                </dxm:VectorLayer>
                <dxm:InformationLayer
                    x:Name="searchInformationLayer"
                    EnableHighlighting="False"
                    EnableSelection="False">
                    <dxm:AzureSearchDataProvider
                        AzureKey="{Binding DevExpressAzureKey, Source={StaticResource DemoValuesProvider}}"
                        GenerateLayerItems="True"
                        LayerItemsGenerating="GeoCodeAndSearchLayerItemsGenerating" />
                </dxm:InformationLayer>
                <dxm:InformationLayer
                    x:Name="trafficIncidentLayer"
                    EnableHighlighting="False"
                    EnableSelection="False"
                    ViewportChanged="MapControlViewportChanged">
                    <dxm:AzureTrafficIncidentDataProvider
                        x:Name="trafficIncidentProvider"
                        AzureKey="{Binding DevExpressAzureKey, Source={StaticResource DemoValuesProvider}}"
                        GenerateLayerItems="True" />
                </dxm:InformationLayer>
            </dxm:MapControl>
            <local:CopyrightControl ProviderName="Azure" />
            <Grid Visibility="{Binding Path=RequestErrorMessageVisible, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="8,8,8,32">
                <Border Background="{dxi:ThemeResource {dxmt:MapBrushesThemeKey ResourceKey=OverlayBackground}}" CornerRadius="3" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding Path=RequestErrorMessage}"
                           FontSize="14"
                           Foreground="Red"
                           TextAlignment="Right"
                           Margin="16,6,16,8"/>
            </Grid>
        </Grid>
    </DockPanel>
</local:MapDemoModule>