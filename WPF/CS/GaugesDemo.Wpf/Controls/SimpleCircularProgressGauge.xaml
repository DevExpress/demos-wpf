<UserControl x:Class="GaugesDemo.Controls.SimpleCircularProgressGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="OrangeGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF900" Offset="0" />
            <GradientStop Color="#FF0000" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <DockPanel>
        <dxe:TrackBarEdit x:Name="TrackBar1" DockPanel.Dock="Top" Value="82" />
        <Border>
            <dxga:CircularGaugeControl>
                <dxga:CircularGaugeControl.Scales>
                    <dxga:ArcScale StartAngle="90" EndAngle="450"
                                   x:Name="SimpleArc"
                                   StartValue="{Binding ElementName=TrackBar1, Path=Minimum}"
                                   EndValue="{Binding ElementName=TrackBar1, Path=Maximum}"
                                   ShowMajorTickmarks="False"
                                   ShowMinorTickmarks="False"
                                   ShowLabels="false"
                                   LayoutMode="Circle" Margin="15">
                        <dxga:ArcScale.CustomElements>
                            <dxga:ScaleCustomElement>
                                <Viewbox>
                                    <TextBlock Margin="28"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource {dxt:ThemeColorsThemeKey ResourceKey=BlackForegroundColor}}"
                                               Text="{Binding ElementName=ProgressRangeBar1, Path=Value, StringFormat='{}{0:n0}%'}" />
                                </Viewbox>
                            </dxga:ScaleCustomElement>
                        </dxga:ArcScale.CustomElements>
                        <dxga:ArcScale.RangeBars>
                            <dxga:ArcScaleRangeBar
                                AnchorValue="{Binding ElementName=SimpleArc, Path=StartValue}"
                                Value="{Binding ElementName=SimpleArc, Path=EndValue}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions Offset="-20" Thickness="15" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="#F5E6DE" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                            <dxga:ArcScaleRangeBar AnchorValue="0"
                                                   Value="{Binding ElementName=TrackBar1, Path=Value}"
                                                   x:Name="ProgressRangeBar1">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions Offset="-20" Thickness="15" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation
                                        Fill="{StaticResource OrangeGradient}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                        </dxga:ArcScale.RangeBars>
                    </dxga:ArcScale>
                </dxga:CircularGaugeControl.Scales>
            </dxga:CircularGaugeControl>
        </Border>
    </DockPanel>
</UserControl>