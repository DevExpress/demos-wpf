<UserControl
    x:Class="GridDemo.GridDemoRibbon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GridDemo"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxdb="http://schemas.devexpress.com/winfx/2008/xaml/demobase"
    xmlns:printing="clr-namespace:DevExpress.XtraPrinting;assembly=DevExpress.Printing.v26.1.Core">
    <dxr:RibbonControl>
        <dxr:RibbonPage Caption="Demo">
            <dxr:RibbonPageGroup Caption="Print and Export" IsVisible="{Binding ExportGrid, Converter={dxmvvm:ObjectToBooleanConverter}}">
                <dxb:BarButtonItem
                    Content="Print Preview"
                    Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/Preview.svg"
                    Command="{Binding ExportGrid.View.Commands.ShowRibbonPrintPreview}" />
                <dxb:BarSplitButtonItem
                    Content="Data Aware Export"
                    IsVisible="{Binding ExportGrid.View, Converter={local:IsNotCardViewToBooleanConverter}}"
                    Hint="An advanced data export engine that supports a lot of MS Excel data analysis capabilites.">
                    <dxmvvm:Interaction.Behaviors>
                        <dxdb:BarSplitButtonItemBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxb:PopupMenu>
                        <dxb:BarButtonItem
                            Content="Export to XLSX"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToXLSX.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleExportHelper.ExportToXlsx(@c.ExportGrid.View)'}" />
                        <dxb:BarButtonItem
                            Content="Export to XLS"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToXLS.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleExportHelper.ExportToXls(@c.ExportGrid.View)'}" />
                        <dxb:BarButtonItem
                            Content="Export to CSV"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToCSV.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleExportHelper.ExportToCsv(@c.ExportGrid.View)'}" />
                    </dxb:PopupMenu>
                </dxb:BarSplitButtonItem>
                <dxb:BarSplitButtonItem Content="WYSIWYG Export" Hint="Allows you to export data in various formats and provides numerous customization options.">
                    <dxmvvm:Interaction.Behaviors>
                        <dxdb:BarSplitButtonItemBehavior />
                    </dxmvvm:Interaction.Behaviors>
                    <dxb:PopupMenu>
                        <dxb:BarButtonItem
                            Content="Export to PDF"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToPDF.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Pdf)'}" />
                        <dxb:BarButtonItem
                            Content="Export to HTML"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToHTML.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Htm)'}" />
                        <dxb:BarButtonItem
                            Content="Export to MHT"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToMHT.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Mht)'}" />
                        <dxb:BarButtonItem
                            Content="Export to RTF"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToRTF.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Rtf)'}" />
                        <dxb:BarButtonItem
                            Content="Export to XLSX"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToXLSX.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Xlsx)'}" />
                        <dxb:BarButtonItem
                            Content="Export to XLS"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToXLS.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Xls)'}" />
                        <dxb:BarButtonItem
                            Content="Export to Text"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToText.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Text)'}" />
                        <dxb:BarButtonItem
                            Content="Export to Image"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToImage.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Image)'}" />
                        <dxb:BarButtonItem
                            Content="Export to DOCX"
                            Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/ExportToDOCX.svg"
                            ItemClick="{DXEvent Handler='$local:DemoModuleWYSIWYGExportHelper.DoExport(@c.ExportGrid.View, $printing:ExportFormat.Docx)'}" />
                    </dxb:PopupMenu>
                </dxb:BarSplitButtonItem>
            </dxr:RibbonPageGroup>
            <dxr:RibbonPageGroup Caption="Report" IsVisible="{Binding ReportService, Converter={dxmvvm:ObjectToBooleanConverter}}">
                <dxb:BarButtonItem
                    Content="Show Wizard"
                    RibbonStyle="Large"
                    Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/NewReportWizard.svg"
                    Hint="Allows you to apply a theme to the report before invoking the report designer."
                    Command="{Binding ReportService.ViewModel.ShowReportWizardCommand}" />
                <dxb:BarButtonItem
                    Content="Show Designer"
                    RibbonStyle="Large"
                    Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/Designer.svg"
                    Hint="Invokes the report designer."
                    Command="{Binding ReportService.ViewModel.EditReportCommand}" />
                <dxb:BarButtonItem
                    Content="Show Preview"
                    RibbonStyle="Large"
                    Glyph="pack://application:,,,/GridDemo;component/Images/Ribbon/Preview.svg"
                    Hint="Invokes the report's print preview."
                    Command="{Binding ReportService.ViewModel.ShowReportPreviewCommand}" />
            </dxr:RibbonPageGroup>
        </dxr:RibbonPage>
    </dxr:RibbonControl>
</UserControl>