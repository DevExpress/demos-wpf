<local:EditorsDemoModule x:Class="EditorsDemo.EmbeddedEditorLabelsModule"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:EditorsDemo"
                         xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                         xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                         xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                         mc:Ignorable="d">
    <UserControl.DataContext>
        <local:EmployeeViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <Style TargetType="{x:Type dxe:ComboBoxEdit}">
            <Setter Property="FocusPopupOnOpen" Value="True" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Name="PART_Options"
                      DockPanel.Dock="Right"
                      dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap"
                      Focusable="False">
            <StackPanel Margin="12" MinWidth="250">
                <GroupBox Header="Selected Editor">
                    <StackPanel>
                        <RadioButton Content="First Name" x:Name="FirstNameRadioButton" Checked="OnChecked" IsChecked="True" />
                        <RadioButton Content="Last Name" x:Name="LastNameRadioButton" Checked="OnChecked" />
                        <RadioButton Content="Full Name" x:Name="FullNameRadioButton" Checked="OnChecked"/>
                        <RadioButton Content="Prefix" x:Name="PrefixRadioButton" Checked="OnChecked"/>
                        <RadioButton Content="Birth Date" x:Name="BirthDateRadioButton" Checked="OnChecked"/>
                        <RadioButton Content="Mobile Phone" x:Name="MobilePhoneRadioButton" Checked="OnChecked"/>
                        <RadioButton Content="Title" x:Name="TitleRadioButton" Checked="OnChecked"/>
                        <RadioButton Content="Department" x:Name="DepartmentRadioButton" Checked="OnChecked"/>
                        <RadioButton Content="Hire Date" x:Name="HireDateRadioButton" Checked="OnChecked"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Properties" x:Name="PropertiesGroupBox" DataContext="{Binding ElementName=FirstNameEdit}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Label:" Margin="0 6 6 0" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" x:Name="labelTextBlock"/>
                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0 6 0 0" Grid.Row="0" Grid.Column="1" AutomationProperties.LabeledBy="{Binding ElementName=labelTextBlock}"/>
                        <CheckBox IsChecked="{Binding AlwaysShowLabelAtTop}" Content="Always show label at top"
                                  Margin="0 6 0 0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
                        <CheckBox IsChecked="{Binding AllowLabelAnimation}" Content="Allow label animation"
                                  Margin="0 6 0 0" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" />
                        <TextBlock Text="NullText:" Margin="0 6 6 0" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                                   x:Name="NullTextTextBlock" />
                        <TextBox Text="{Binding NullText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0 6 0 0" Grid.Row="3" Grid.Column="1" x:Name="NullTextTextBox" AutomationProperties.LabeledBy="{Binding ElementName=NullTextTextBlock}"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Width="400" HorizontalAlignment="Center" Margin="0 60 0 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <dxe:TextEdit Label="First Name" Margin="0 6 6 0" x:Name="FirstNameEdit"
                                  EditValue="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    <dxe:TextEdit Label="Last Name" Margin="0 6 6 0" x:Name="LastNameEdit"
                                  EditValue="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                    <dxe:TextEdit Label="Full Name" Margin="0 6 6 0" x:Name="FullNameEdit"
                                  EditValue="{Binding FullName, Mode=OneWay}" IsReadOnly="True"/>
                    <dxe:ComboBoxEdit Label="Prefix" Margin="0 6 6 0" x:Name="PrefixEdit"
                                      EditValue="{Binding Prefix, Mode=TwoWay}"
                                      IsTextEditable="False" ApplyItemTemplateToSelectedItem="True">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EnumItemsSourceBehavior EnumType="{x:Type local:PersonPrefix}" ImageSize="16 16"/>
                        </dxmvvm:Interaction.Behaviors>
                    </dxe:ComboBoxEdit>
                    <dxe:DateEdit Label="Birth Date" Margin="0 6 6 0" x:Name="BirthDateEdit"
                                  EditValue="{Binding BirthDate, Mode=TwoWay}"/>
                    <dxe:ButtonEdit Label="Mobile Phone" Margin="0 6 6 0" IsTextEditable="True" x:Name="MobilePhoneEdit"
                                    EditValue="{Binding MobilePhone, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                    MaskType="Simple" Mask="(999) 000-0000" MaskUseAsDisplayFormat="True"
                                    AllowDefaultButton="False">
                        <dxe:ImageButtonInfo Glyph="/DevExpress.Images.v26.1;component/SvgImages/Icon Builder/Electronics_PhoneIphone.svg"/>
                    </dxe:ButtonEdit>
                </StackPanel>
                <dxe:ImageEdit Grid.Column="1" Margin="0 6 0 0"
                               EditValue="pack://application:,,,/EditorsDemo;component/Images/person.jpg"
                               ShowMenuMode="Always"/>
            </Grid>
            <dxe:TextEdit Label="Title" Margin="0 6 0 0" x:Name="TitleEdit"
                          EditValue="{Binding Title, Mode=TwoWay}"/>
            <dxe:ComboBoxEdit Label="Department" Margin="0 6 0 0" x:Name="DepartmentEdit"
                              EditValue="{Binding Department, Mode=TwoWay}"
                              ItemsSource="{dxe:EnumItemsSource EnumType=local:EmployeeDepartment, AllowImages=False}"
                              IsTextEditable="False" ValueMember="Value" DisplayMember="Name"/>
            <dxe:DateEdit Label="Hire Date" Margin="0 6 0 0" x:Name="HireDateEdit"
                          EditValue="{Binding HireDate, Mode=TwoWay}" AllowFocusEditorButtons="True"/>
        </StackPanel>
    </DockPanel>
</local:EditorsDemoModule>