Imports DevExpress.Xpf.Core
Imports DevExpress.Xpf.DemoBase

Namespace SchedulingDemo

    <NoAutogeneratedCodeFiles, CodeFiles("Modules/Highlighted/PrintingTemplatesDemoModule.xaml", "ViewModels/Highlighted/PrintingTemplatesDemoViewModel.(cs)", "Themes/Ribbon.xaml")>
    Public Partial Class PrintingTemplatesDemoModule
        Inherits SchedulingDemoModule

        Private Property IsModuleLoaded As Boolean

        Public Sub New()
            InitializeComponent()
            MainWindow.CommonRibbon.Init(scheduler)
            MainWindow.CommonRibbon.ShowPageHome = False
            AddHandler ModuleLoaded, Sub(s, e) IsModuleLoaded = True
            AddHandler ModuleUnloaded, Sub(s, e) IsModuleLoaded = False
        End Sub

        Private Sub OnTabControlSelectionChanged(ByVal sender As Object, ByVal e As TabControlSelectionChangedEventArgs)
            If Not IsModuleLoaded Then Return
            MainWindow.CommonRibbon.ShowPageHome = tabControl.SelectedContainer Is schedulerTab
            MainWindow.CommonRibbon.Update()
        End Sub
    End Class
End Namespace
