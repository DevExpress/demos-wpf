    Public Class SelectedItemNameBindingBehavior
        Inherits Behavior(Of TreeMapControl)

        Public Shared ReadOnly SelectedItemNameProperty As DependencyProperty = DependencyProperty.Register(NameOf(SelectedItemNameBindingBehavior.SelectedItemName), GetType(String), GetType(SelectedItemNameBindingBehavior), New PropertyMetadata(Nothing, Sub(d, e) CType(d, SelectedItemNameBindingBehavior).OnSelectedItemNameChanged()))

        Public Shared ReadOnly CountriesInfoProperty As DependencyProperty = DependencyProperty.Register(NameOf(SelectedItemNameBindingBehavior.CountriesInfo), GetType(CountriesInfo), GetType(SelectedItemNameBindingBehavior), New PropertyMetadata(CType(Nothing, PropertyChangedCallback)))

        Public Property SelectedItemName As String
            Get
                Return CStr(GetValue(SelectedItemNameProperty))
            End Get

            Set(ByVal value As String)
                SetValue(SelectedItemNameProperty, value)
            End Set
        End Property

        Public Property CountriesInfo As CountriesInfo
            Get
                Return CType(GetValue(CountriesInfoProperty), CountriesInfo)
            End Get

            Set(ByVal value As CountriesInfo)
                SetValue(CountriesInfoProperty, value)
            End Set
        End Property

        Private Sub TreeMapSelectionChanged(ByVal sender As Object, ByVal e As TreeMapSelectionChangedEventArgs)
            Dim info = CType(e.Selection.FirstOrDefault(), CountryStatisticInfo)
            If info IsNot Nothing Then SelectedItemName = info.Name
        End Sub

        Private Sub OnSelectedItemNameChanged()
            If AssociatedObject IsNot Nothing Then AssociatedObject.SelectedItem = CountriesInfo.SingleOrDefault(Function(info) Equals(info.Name, SelectedItemName))
        End Sub

        Protected Overrides Sub OnAttached()
            MyBase.OnAttached()
            AddHandler AssociatedObject.SelectionChanged, AddressOf TreeMapSelectionChanged
            OnSelectedItemNameChanged()
        End Sub
    End Class

    Friend Class ChartPaletteToTreeMapPaletteConverter
        Inherits ForwardOnlyValueConverter

        Public Overrides Function Convert(ByVal value As Object, ByVal targetType As Type, ByVal parameter As Object, ByVal culture As CultureInfo) As Object
            Dim chartColors As Palette = CType(value, Palette)
            Dim rangeStops As DoubleCollection = CType(parameter, DoubleCollection)
            Dim colorsCount As Integer = CInt(rangeStops(rangeStops.Count - 1) - rangeStops(0)) + 1
            Dim palette As DevExpress.Xpf.TreeMap.CustomPalette = New DevExpress.Xpf.TreeMap.CustomPalette()
            For i As Integer = 0 To colorsCount - 1
                palette.Colors.Add(chartColors(i))
            Next

            Return palette
        End Function
    End Class

    Friend Class SelectedIndexToBrushConverter
        Inherits MarkupExtension
        Implements IMultiValueConverter

        Public Function Convert(ByVal values As Object(), ByVal targetType As Type, ByVal parameter As Object, ByVal culture As CultureInfo) As Object Implements IMultiValueConverter.Convert
            If values(0).GetType() IsNot GetType(Integer) OrElse CInt(values(0)) < 0 OrElse Not(TypeOf values(1) Is Palette) Then Return Nothing
            Dim index As Integer = CInt(values(0))
            Dim palette As Palette = CType(values(1), Palette)
            Dim brush As SolidColorBrush = New SolidColorBrush(palette(index))
            brush.Freeze()
            Return brush
        End Function

        Public Function ConvertBack(ByVal value As Object, ByVal targetTypes As Type(), ByVal parameter As Object, ByVal culture As CultureInfo) As Object() Implements IMultiValueConverter.ConvertBack
            Return Nothing
        End Function

        Public Overrides Function ProvideValue(ByVal serviceProvider As IServiceProvider) As Object
            Return Me
        End Function
    End Class
