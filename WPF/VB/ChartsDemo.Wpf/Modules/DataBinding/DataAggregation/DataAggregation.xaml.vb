    <CodeFile("Modules/DataBinding/DataAggregation/DataAggregation.xaml"), CodeFile("Modules/DataBinding/DataAggregation/DataAggregation.xaml.(cs)"), CodeFile("DataModels/DevAVSalesData.(cs)"), CodeFile("DataModels/DateTimeArgumentData.(cs)"), CodeFile("DataModels/NumericArgumentData.(cs)"), CodeFile("Modules/DataBinding/DataAggregation/DateTimeDataAggregationTab.xaml"), CodeFile("Modules/DataBinding/DataAggregation/DateTimeDataAggregationTab.xaml.(cs)"), CodeFile("Modules/DataBinding/DataAggregation/NumericDataAggregationTab.xaml"), CodeFile("Modules/DataBinding/DataAggregation/NumericDataAggregationTab.xaml.(cs)"), CodeFile("Modules/DataBinding/DataAggregation/QualitativeDataAggregationTab.xaml"), CodeFile("Modules/DataBinding/DataAggregation/QualitativeDataAggregationTab.xaml.(cs)"), CodeFile("Modules/DataBinding/DataAggregation/TimeSpanDataAggregationTab.xaml"), CodeFile("Modules/DataBinding/DataAggregation/TimeSpanDataAggregationTab.xaml.(cs)"), CodeFile("Modules/DataBinding/StandardDeviationCustomAggregateFunction.(cs)"), NoAutogeneratedCodeFiles>
    Public Partial Class DataAggregationDemo
        Inherits ChartsDemoModule

        Public Sub New()
            AddHandler ModuleLoaded, AddressOf OnModuleLoaded
            InitializeComponent()
        End Sub

        Private Sub OnTabControlSelectionChanged(ByVal sender As Object, ByVal e As TabControlSelectionChangedEventArgs)
            UpdateTabContent()
        End Sub

        Private Sub OnModuleLoaded(ByVal sender As Object, ByVal e As RoutedEventArgs)
            UpdateTabContent()
        End Sub

        Private Sub UpdateTabContent()
            If Not IsModuleLoaded Then Return
            Dim selectedTab = tabControl.SelectedContainer
            If selectedTab Is Nothing OrElse selectedTab.Content IsNot Nothing Then Return
            If selectedTab Is numericTab Then
                LoadTabContent(selectedTab, Function() New NumericDataAggregationTab())
                Return
            End If

            If selectedTab Is dateTimeTab Then
                LoadTabContent(selectedTab, Function() New DateTimeDataAggregationTab())
                Return
            End If

            If selectedTab Is qualitative Then
                LoadTabContent(selectedTab, Function() New QualitativeDataAggregationTab())
                Return
            End If

            If selectedTab Is timeSpan Then
                LoadTabContent(selectedTab, Function() New TimeSpanDataAggregationTab())
                Return
            End If
        End Sub

        Private Sub LoadTabContent(ByVal tab As DXTabItem, ByVal createContent As Func(Of FrameworkElement))
            MainWindow.Instance.ShowSplashScreen()
            Dim content = createContent()
            AddHandler content.Loaded, AddressOf OnTabContentLoaded
            tab.Content = content
        End Sub

        Private Sub OnTabContentLoaded(ByVal sender As Object, ByVal e As RoutedEventArgs)
            Dim content As FrameworkElement = CType(sender, FrameworkElement)
            RemoveHandler content.Loaded, AddressOf OnTabContentLoaded
            Dispatcher.InvokeAsync(Sub() MainWindow.Instance.HideSplashScreen(), DispatcherPriority.ContextIdle)
        End Sub
    End Class
End Namespace
