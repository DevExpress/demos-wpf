<local:ChartsDemoModule
    x:Class="ChartsDemo.DataAggregationDemo"
    x:Name="demoModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ChartsDemo"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{dxmvvm:ViewModelSource Type=local:TabbedModuleViewModel}">
    <!--#region Resources-->
    <local:ChartsDemoModule.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/ChartsDemo;component/Themes/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:ChartsDemoModule.Resources>
    <!--#endregion-->

    <DockPanel>
        <!--#region Options-->
        <ScrollViewer
            Name="PART_Options"
            Style="{StaticResource optionsScrollViewerStyle}">
            <ContentPresenter 
                DataContext="{Binding SelectedTab.Content.DataContext}"
                Content="{Binding SelectedTab.Content.Options}"/>
        </ScrollViewer>
        <!--#endregion-->

        <Grid>
            <dx:DXTabControl
                x:Name="tabControl"
                SelectedTabItem="{Binding SelectedTab, Mode=TwoWay}"
                Style="{StaticResource ResourceKey=moduleTabControlStyle}"
                SelectionChanged="OnTabControlSelectionChanged">
                <dx:DXTabControl.View>
                    <dx:TabControlScrollView ShowHeaderMenu="True" />
                </dx:DXTabControl.View>
                <dx:DXTabItem x:Name="numericTab" Header="Numeric" />
                <dx:DXTabItem x:Name="dateTimeTab" Header="Date-Time" />
                <dx:DXTabItem x:Name="qualitative" Header="Qualitative"/>
                <dx:DXTabItem x:Name="timeSpan" Header="Time-Span"/>
            </dx:DXTabControl>
        </Grid>
    </DockPanel>
</local:ChartsDemoModule>