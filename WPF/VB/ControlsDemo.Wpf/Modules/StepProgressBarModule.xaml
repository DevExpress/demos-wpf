<local:ControlsDemoModule
    x:Class="ControlsDemo.StepProgressBarModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxco="http://schemas.devexpress.com/winfx/2008/xaml/controls"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:local="clr-namespace:ControlsDemo"
    DataContext="{dxmvvm:ViewModelSource Type=local:StepProgressBarModuleViewModel}">
    <local:ControlsDemoModule.Resources>
        <DataTemplate x:Key="farContentTemplate">
            <StackPanel>
                <TextBlock Text="{Binding StatusDescription}" FontSize="13"/>
                <TextBlock Text="{Binding Date}" FontSize="11"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="nearContentTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="16"/>
            </StackPanel>
        </DataTemplate>
    </local:ControlsDemoModule.Resources>
    <DockPanel>
        <!--#region Options-->
        <dxlc:LayoutControl Name="PART_Options"
                            DockPanel.Dock="Right"
                            Orientation="Vertical"
                            Margin="5,5,10,0"
                            MinWidth="300">
            <dxlc:LayoutItem Label="SelectedItemState:">
                <dxe:ComboBoxEdit VerticalAlignment="Center"
                                  IsTabStop="False"
                                  IsTextEditable="False"
                                  ItemsSource="{dxe:EnumItemsSource EnumType=dxco:StepProgressBarItemState}"
                                  EditValue="{Binding SelectedItemState, ElementName=stepProgressBar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="SelectedItem:">
                <dxe:ComboBoxEdit VerticalAlignment="Center"
                                  IsTabStop="False"
                                  IsTextEditable="False"
                                  DisplayMember="NotStartedOrderInfo.Status"
                                  ItemsSource="{Binding OrderTrackSteps}"
                                  EditValue="{Binding SelectedItem, ElementName=stepProgressBar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="AllowItemClick:">
                <dxe:CheckEdit VerticalAlignment="Center"
                               EditValue="{Binding AllowItemClick, ElementName=stepProgressBar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="ReverseOrder:">
                <dxe:CheckEdit VerticalAlignment="Center"
                               EditValue="{Binding ReverseOrder, ElementName=stepProgressBar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="Offset:">
                <dxe:TrackBarEdit x:Name="offsetValue"
                                          TickPlacement="BottomRight"
                                          Height="20"
                                          LargeStep="5"
                                          Maximum="80"
                                          SmallStep="2.5"
                                          Value="{Binding Offset, ElementName=stepProgressBar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="5,0,0,0" />
            </dxlc:LayoutItem>
        </dxlc:LayoutControl>
        <!--#endregion-->
        <Grid>
            <dxco:StepProgressBar x:Name="stepProgressBar"
                                  Offset="0" 
                                  Orientation="Vertical" 
                                  SelectedItemState="Indeterminate" 
                                  ItemsSource="{Binding OrderTrackSteps}" 
                                  IndicatorLength="40" 
                                  FarContentLength="250">
                <dxco:StepProgressBar.ItemContainerStyle>
                    <Style TargetType="{x:Type dxco:StepProgressBarItem}">
                        <Setter Property="NearContent" Value="{Binding NotStartedOrderInfo}"/>
                        <Setter Property="Content" Value="{Binding NotStartedIndicatorContent}"/>
                        <Setter Property="FarContent" Value="{Binding NotStartedOrderInfo}"/>
                        <Setter Property="NearContentTemplate" Value="{StaticResource nearContentTemplate}"/>
                        <Setter Property="FarContentTemplate" Value="{StaticResource farContentTemplate}"/>
                        <Setter Property="NearContentHorizontalAlignment" Value="Right"/>
                        <Setter Property="FarContentHorizontalAlignment" Value="Left"/>
                        <Setter Property="Height" Value="55"/>
                        <Setter Property="IndicatorGeometry">
                            <Setter.Value>
                                <EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=State}" Value="Indeterminate">
                                <Setter Property="NearContent" Value="{Binding IndeterminateOrderInfo}"/>
                                <Setter Property="FarContent" Value="{Binding IndeterminateOrderInfo}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=State}" Value="Completed">
                                <Setter Property="NearContent" Value="{Binding CompletedOrderInfo}"/>
                                <Setter Property="FarContent" Value="{Binding CompletedOrderInfo}"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Path
                                                Width="13"
                                                Height="13"
                                                Data="F0 M14,14z M0,0z M0,6.49623C0,6.07378 0.150273,5.67746 0.44472,5.362 0.74104,5.04454 1.14206,4.85607 1.59754,4.85607 2.05302,4.85607 2.45404,5.04454 2.75036,5.362L5.19684,7.98301 11.2426,1.50594C11.5389,1.18848 11.94,1 12.3954,1 12.6105,1 12.8293,1.04336 13.0374,1.14034 13.2306,1.22395 13.404,1.34658 13.548,1.50518 13.6923,1.65499 13.7984,1.82559 13.8723,2.00325 13.9619,2.21324 14,2.42989 14,2.64017 14,3.07372 13.8398,3.46954 13.5483,3.78193L6.34966,11.4941C6.05334,11.8115 5.65231,12 5.19684,12 4.74136,12 4.34034,11.8115 4.04402,11.4941L0.44472,7.638C0.144947,7.31684,0,6.91561,0,6.49623z"
                                                Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Mode=Self}}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>

                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </dxco:StepProgressBar.ItemContainerStyle>
            </dxco:StepProgressBar>
        </Grid>
    </DockPanel>
</local:ControlsDemoModule>
