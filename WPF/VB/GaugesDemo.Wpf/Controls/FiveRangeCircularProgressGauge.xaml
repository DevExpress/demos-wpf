<UserControl x:Class="GaugesDemo.Controls.FiveRangeCircularProgressGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GaugesDemo.Controls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
             xmlns:converters="clr-namespace:GaugesDemo.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#E6E6E6" />
    </UserControl.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:FiveRangeCircularProgressGauge}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Temazepam:" />
            <dxe:TrackBarEdit x:Name="Range1" Value="23" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Guaifenesin:" />
            <dxe:TrackBarEdit x:Name="Range2" Value="34" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Salicylic Acid:" />
            <dxe:TrackBarEdit x:Name="Range3" Value="67" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Fluoride:" />
            <dxe:TrackBarEdit x:Name="Range4" Value="93" />
        </StackPanel>

        <Grid Grid.Column="1" Grid.RowSpan="5">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <dxga:CircularGaugeControl Grid.RowSpan="2" Grid.ColumnSpan="2">
                <dxga:CircularGaugeControl.Scales>
                    <dxga:ArcScale StartAngle="-90"
                                   EndAngle="180"
                                   x:Name="MultipleSegmentArc"
                                   StartValue="{Binding MinValue}"
                                   EndValue="{Binding MaxValue}"
                                   ShowMajorTickmarks="False"
                                   ShowMinorTickmarks="False"
                                   ShowLabels="false"
                                   LayoutMode="Circle" Margin="15">
                        <dxga:ArcScale.LabelOptions>
                            <dxga:ArcScaleLabelOptions Offset="-50" />
                        </dxga:ArcScale.LabelOptions>
                        <dxga:ArcScale.RangeBars>
                            <dxga:ArcScaleRangeBar
                                AnchorValue="{Binding ElementName=MultipleSegmentArc, Path=StartValue}"
                                Value="{Binding ElementName=MultipleSegmentArc, Path=EndValue}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions
                                        Offset="{Binding ProgressThickness, Converter={converters:ThicknessToOffsetConverter}, ConverterParameter=4}"
                                        Thickness="{Binding Thickness}" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation
                                        Fill="{StaticResource ProgressBarBackgroundBrush}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                            <dxga:ArcScaleRangeBar
                                AnchorValue="{Binding ElementName=MultipleSegmentArc, Path=StartValue}"
                                Value="{Binding ElementName=MultipleSegmentArc, Path=EndValue}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions
                                        Offset="{Binding ProgressThickness, Converter={converters:ThicknessToOffsetConverter}, ConverterParameter=3}"
                                        Thickness="{Binding Thickness}" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation
                                        Fill="{StaticResource ProgressBarBackgroundBrush}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                            <dxga:ArcScaleRangeBar
                                AnchorValue="{Binding ElementName=MultipleSegmentArc, Path=StartValue}"
                                Value="{Binding ElementName=MultipleSegmentArc, Path=EndValue}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions
                                        Offset="{Binding ProgressThickness, Converter={converters:ThicknessToOffsetConverter}, ConverterParameter=2}"
                                        Thickness="{Binding Thickness}" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation
                                        Fill="{StaticResource ProgressBarBackgroundBrush}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                            <dxga:ArcScaleRangeBar
                                AnchorValue="{Binding ElementName=MultipleSegmentArc, Path=StartValue}"
                                Value="{Binding ElementName=MultipleSegmentArc, Path=EndValue}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions
                                        Offset="{Binding ProgressThickness, Converter={converters:ThicknessToOffsetConverter}, ConverterParameter=1}"
                                        Thickness="{Binding Thickness}" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation
                                        Fill="{StaticResource ProgressBarBackgroundBrush}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                            <dxga:ArcScaleRangeBar Value="{Binding ElementName=Range4, Path=Value}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions
                                        Offset="{Binding ProgressThickness, Converter={converters:ThicknessToOffsetConverter}, ConverterParameter=4}"
                                        Thickness="{Binding Thickness}" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="{Binding Range4Brush}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                            <dxga:ArcScaleRangeBar Value="{Binding ElementName=Range3, Path=Value}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions
                                        Offset="{Binding ProgressThickness, Converter={converters:ThicknessToOffsetConverter}, ConverterParameter=3}"
                                        Thickness="{Binding Thickness}" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="{Binding Range3Brush}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                            <dxga:ArcScaleRangeBar Value="{Binding ElementName=Range2, Path=Value}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions
                                        Offset="{Binding ProgressThickness, Converter={converters:ThicknessToOffsetConverter}, ConverterParameter=2}"
                                        Thickness="{Binding Thickness}" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="{Binding Range2Brush}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                            <dxga:ArcScaleRangeBar Value="{Binding ElementName=Range1, Path=Value}">
                                <dxga:ArcScaleRangeBar.Options>
                                    <dxga:ArcScaleRangeBarOptions
                                        Offset="{Binding ProgressThickness, Converter={converters:ThicknessToOffsetConverter}, ConverterParameter=1}"
                                        Thickness="{Binding Thickness}" />
                                </dxga:ArcScaleRangeBar.Options>
                                <dxga:ArcScaleRangeBar.Presentation>
                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="{Binding Range1Brush}" />
                                </dxga:ArcScaleRangeBar.Presentation>
                            </dxga:ArcScaleRangeBar>
                        </dxga:ArcScale.RangeBars>
                    </dxga:ArcScale>
                </dxga:CircularGaugeControl.Scales>
            </dxga:CircularGaugeControl>

            <Grid HorizontalAlignment="Right" Margin="0,0,7,0">
                <Grid.Resources>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="25" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DXBinding Expr='`Temazepam` + `, ` + @e(Range1).Value + `%`'}" />
                <TextBlock Grid.Row="1" Text="{DXBinding Expr='`Guaifenesin` + `, ` + @e(Range2).Value + `%`'}" />
                <TextBlock Grid.Row="2" Text="{DXBinding Expr='`Salicylic Acid` + `, ` + @e(Range3).Value + `%`'}" />
                <TextBlock Grid.Row="3" Text="{DXBinding Expr='`Fluoride` + `, ` + @e(Range4).Value + `%`'}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>