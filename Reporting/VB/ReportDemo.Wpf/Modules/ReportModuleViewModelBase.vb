Imports System.IO
Imports DevExpress.Mvvm
Imports DevExpress.Mvvm.Native
Imports DevExpress.Utils
Imports DevExpress.Xpf.DemoBase
Imports DevExpress.Xpf.DocumentViewer
Imports DevExpress.XtraReports
Imports DevExpress.XtraReports.Native
Imports DevExpress.XtraReports.UI

Namespace ReportWpfDemo

    <NoAutogeneratedCodeFiles>
    Public MustInherit Class ReportModuleViewModelBase
        Inherits ViewModelBase

        Private fReport As IReport

        Public Overridable Property Report As IReport
            Get
                Return fReport
            End Get

            Set(ByVal value As IReport)
                Dim oldValue = fReport
                If SetProperty(fReport, value, Function() Report) Then OnReportChanged(oldValue)
            End Set
        End Property

        Public Overridable ReadOnly Property DefaultZoomFactor As Double
            Get
                Return 0.9R
            End Get
        End Property

        Public Overridable ReadOnly Property DefaultZoomMode As ZoomMode
            Get
                Return ZoomMode.Custom
            End Get
        End Property

        Public Overridable ReadOnly Property ShowPageMargins As Boolean
            Get
                Return True
            End Get
        End Property

        Public Overridable ReadOnly Property HighlightEditingFields As Boolean
            Get
                Return False
            End Get
        End Property

        Public Overridable ReadOnly Property PageDisplayMode As PageDisplayMode
            Get
                Return PageDisplayMode.Single
            End Get
        End Property

        Public Overridable ReadOnly Property PageColumnsCount As Integer
            Get
                Return 1
            End Get
        End Property

        Public Overridable ReadOnly Property UseAsyncDocumentCreation As DefaultBoolean
            Get
                Return DefaultBoolean.True
            End Get
        End Property

        Public Overridable Property ShowNavigationPane As Boolean

        Protected Overridable ReadOnly Property WindowService As IWindowService
            Get
                Return Nothing
            End Get
        End Property

        Public Sub New()
            InitializeReport()
            ShowNavigationPane = False
        End Sub

        Public Overridable Sub InitializeReport()
            Report = CreateReport()
        End Sub

        Protected MustOverride Function CreateReport() As IReport

        Public Overridable Sub Clean()
            Report.[Do](Sub(x)
                x.StopPageBuilding()
                UnsubscribeReport(x)
                x.Dispose()
            End Sub)
            Report = Nothing
        End Sub

        Public Sub ShowDesigner()
            Report.StopPageBuilding()
            Dim clonedReport = CloneReport(CType(Report, XtraReport))
            Dim reportDesignerViewModel = New ReportDesignerViewModel(clonedReport)
            WindowService.Show(GetType(ReportDesignerControl).FullName, reportDesignerViewModel)
            If reportDesignerViewModel.Saved Then
                Report = CloneReport(reportDesignerViewModel.Report)
            ElseIf Report.PrintingSystemBase.PageCount = 0 Then
                Report.CreateDocument()
            End If
        End Sub

        Protected Overridable Function CanShowDesigner() As Boolean
            Return True
        End Function

        Private Sub OnReportChanged(ByVal oldValue As IReport)
            If IsInDesignMode Then Return
            UnsubscribeReport(oldValue)
            SubscribeReport(Report)
        End Sub

        Private Shared Function CloneReport(ByVal report As XtraReport) As XtraReport
            Using stream = New MemoryStream()
                report.SaveLayoutToXml(stream)
                stream.Position = 0
                Return XtraReport.FromStream(stream, True)
            End Using
        End Function

        Private Sub SubscribeReport(ByVal report As IReport)
            report.Do(Sub(x) AddHandler x.PrintingSystemBase.CreateDocumentException, AddressOf OnCreateDocumentException)
        End Sub

        Private Sub UnsubscribeReport(ByVal report As IReport)
            report.Do(Sub(x) RemoveHandler x.PrintingSystemBase.CreateDocumentException, AddressOf OnCreateDocumentException)
        End Sub

        Private Sub OnCreateDocumentException(ByVal sender As Object, ByVal args As DevExpress.XtraPrinting.ExceptionEventArgs)
            args.Handled = True
            Report.StopPageBuilding()
        End Sub

        Private Sub ResetDataAdapters(ByVal report As XtraReportBase)
            If report Is Nothing Then Return
            Dim enumerator = New NestedComponentEnumerator(New Object() {report})
            While enumerator.MoveNext()
                Dim dataContainer = TryCast(enumerator.Current, IDataContainer)
                If dataContainer IsNot Nothing Then dataContainer.DataAdapter = Nothing
                Dim subreport As XRSubreport = TryCast(enumerator.Current, XRSubreport)
                If subreport IsNot Nothing Then ResetDataAdapters(TryCast(subreport.ReportSource, XtraReportBase))
            End While
        End Sub
    End Class
End Namespace
