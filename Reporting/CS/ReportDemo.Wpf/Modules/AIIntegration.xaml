<local:ReportModuleBase x:Class="ReportWpfDemo.AIIntegration"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:dxp="http://schemas.devexpress.com/winfx/2008/xaml/printing"
                        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                        xmlns:dxai="http://schemas.devexpress.com/winfx/2008/xaml/ai"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:ReportWpfDemo"
                        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <local:ReportModuleBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReportWpfDemo;component/Themes/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:ReportModuleBase.Resources>

    <local:ReportModuleBase.DataContext>
        <local:AIIntegrationModuleViewModel />
    </local:ReportModuleBase.DataContext>

    <dxp:DocumentPreviewControl Name="viewer" Style="{StaticResource DocumentPreviewControlDemoModuleStyle}">
        <dxmvvm:Interaction.Behaviors>
            <dxai:DocumentSummarizeBehavior />
            <dxai:DocumentTranslateBehavior>
                <dxai:LanguageInfo Culture="de-DE"/>
                <dxai:LanguageInfo Culture="es-ES"/>
                <dxai:LanguageInfo Culture="pt-BR"/>
            </dxai:DocumentTranslateBehavior>
            <dxai:DocumentTranslateInlineBehavior>
                <dxai:LanguageInfo Culture="de-DE"/>
                <dxai:LanguageInfo Culture="es-ES"/>
                <dxai:LanguageInfo Culture="pt-BR"/>
            </dxai:DocumentTranslateInlineBehavior>
        </dxmvvm:Interaction.Behaviors>
    </dxp:DocumentPreviewControl>
</local:ReportModuleBase>
