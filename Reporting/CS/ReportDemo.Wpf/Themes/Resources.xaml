<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ReportWpfDemo"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                    xmlns:dxpp="http://schemas.devexpress.com/winfx/2008/xaml/printing/parameters"
                    xmlns:dxpbars="http://schemas.devexpress.com/winfx/2008/xaml/printing/bars"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:dxp="http://schemas.devexpress.com/winfx/2008/xaml/printing"
                    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon">

    <local:DemoEditingFieldTemplateSelector x:Key="demoEditingFieldTemplateSelector">
        <local:DemoEditingFieldTemplateSelector.Templates>
            <DataTemplate x:Key="Name">
                <dxe:TextEdit MaskType="RegEx"
                                      Mask="[A-Z -.]+"
                                      x:Name="PART_Editor"
                                      EditValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      ShowBorder="False" />
            </DataTemplate>
            <DataTemplate x:Key="NumbersAndUppercaseLetters">
                <dxe:TextEdit MaskType="RegEx"
                                      Mask="[A-Z0-9]+"
                                      x:Name="PART_Editor"
                                      EditValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      ShowBorder="False" />
            </DataTemplate>
            <DataTemplate x:Key="UppercaseText">
                <dxe:TextEdit MaskType="RegEx"
                                      Mask="[A-Z0-9 ,-/]+"
                                      x:Name="PART_Editor"
                                      EditValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      ShowBorder="False" />
            </DataTemplate>
            <DataTemplate x:Key="NumbersAndUppercaseLatinLetters">
                <dxe:TextEdit MaskType="RegEx"
                                      Mask="[A-Z0-9]+"
                                      x:Name="PART_Editor"
                                      EditValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      ShowBorder="False" />
            </DataTemplate>
            <DataTemplate x:Key="Day">
                <dxe:TextEdit MaskType="DateTime"
                                      Mask="dd" MaskUseAsDisplayFormat="True"
                                      x:Name="PART_Editor"
                                      EditValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      ShowBorder="False" />
            </DataTemplate>
            <DataTemplate x:Key="Month">
                <dxe:TextEdit MaskType="DateTime"
                                      Mask="MM" MaskUseAsDisplayFormat="True"
                                      x:Name="PART_Editor"
                                      EditValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      ShowBorder="False" />
            </DataTemplate>
            <DataTemplate x:Key="Year">
                <dxe:TextEdit MaskType="DateTime"
                                      Mask="yyyy" MaskUseAsDisplayFormat="True"
                                      x:Name="PART_Editor"
                                      EditValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      ShowBorder="False" />
            </DataTemplate>

        </local:DemoEditingFieldTemplateSelector.Templates>
    </local:DemoEditingFieldTemplateSelector>

    <local:DemoParameterTemplateSelector x:Key="demoParameterTemplateSelector">
        <local:DemoParameterTemplateSelector.Templates>
            <DataTemplate x:Key="OrderIdParameter">
                <dxpp:ParameterLineLayout>
                    <dxe:SpinEdit Grid.Column="1"
                                          Margin="0,3"
                                          InvalidValueBehavior="AllowLeaveEditor"
                                          EditValueType="{Binding Type, Mode=OneWay}"
                                          EditValue="{Binding Value, ValidatesOnDataErrors=True, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          MinValue="10248"
                                          MaxValue="11077" />
                </dxpp:ParameterLineLayout>
            </DataTemplate>

            <DataTemplate x:Key="MaxRowCountParameter">
                <dxpp:ParameterLineLayout>
                    <dxe:SpinEdit Grid.Column="1"
                                          Margin="0,3"
                                          InvalidValueBehavior="AllowLeaveEditor"
                                          EditValueType="{Binding Type, Mode=OneWay}"
                                          EditValue="{Binding Value, ValidatesOnDataErrors=True, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          MinValue="1"
                                          MaxValue="{x:Static sys:Decimal.MaxValue}" />
                </dxpp:ParameterLineLayout>
            </DataTemplate>
        </local:DemoParameterTemplateSelector.Templates>
    </local:DemoParameterTemplateSelector>

    <Style x:Key="DocumentPreviewControlDemoModuleStyle" TargetType="dxp:DocumentPreviewControl">
        <Setter Property="RequestDocumentCreation" Value="True" />
        <Setter Property="UseAsyncDocumentCreation" Value="{Binding UseAsyncDocumentCreation, Mode=OneWay}" />
        <Setter Property="DocumentSource" Value="{Binding Report}" />
        <Setter Property="ResetSettingsOnDocumentClose" Value="False" />
        <Setter Property="DisposeDocumentOnUnload" Value="False" />
        <Setter Property="ShowPageMargins" Value="{Binding ShowPageMargins}" />
        <Setter Property="ShowNavigationPane" Value="{Binding ShowNavigationPane, Mode=TwoWay}" />
        <Setter Property="ZoomFactor" Value="{Binding DefaultZoomFactor, Mode=OneWay}" />
        <Setter Property="ZoomMode" Value="{Binding DefaultZoomMode, Mode=OneWay}" />
        <Setter Property="PageDisplayMode" Value="{Binding PageDisplayMode, Mode=OneWay}" />
        <Setter Property="ColumnsCount" Value="{Binding PageColumnsCount, Mode=OneWay}" />
        <Setter Property="HighlightEditingFields" Value="{Binding HighlightEditingFields, Mode=OneWay}" />
        <Setter Property="EditingFieldTemplateSelector" Value="{StaticResource demoEditingFieldTemplateSelector}" />
    </Style>
    <Style x:Key="DocumentPreviewControlWithRunReportDesignerButton" TargetType="dxp:DocumentPreviewControl" BasedOn="{StaticResource DocumentPreviewControlDemoModuleStyle}" x:Shared="false">
        <Setter Property="CommandProvider">
            <Setter.Value>
                <dxp:DocumentCommandProvider>
                    <dxp:DocumentCommandProvider.RibbonActions>
                        <dxb:InsertAction Index="0" ContainerName="{x:Static dxpbars:DefaultPreviewBarItemNames.PreviewPage}">
                            <dxr:RibbonPageGroup Caption="Actions">
                                <dxb:BarButtonItem Content="Designer"
                                           Command="{Binding Path=(dxp:DocumentPreviewControl.ActualViewer).DataContext.ShowDesignerCommand, RelativeSource={RelativeSource Mode=Self}}"
                                           LargeGlyph="pack://application:,,,/DevExpress.Xpf.ReportDesigner.v26.1;component/Images/Svg/Designer.svg" />
                            </dxr:RibbonPageGroup>
                        </dxb:InsertAction>
                    </dxp:DocumentCommandProvider.RibbonActions>
                </dxp:DocumentCommandProvider>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>